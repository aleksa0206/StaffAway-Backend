generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

//**************NACIN PISANJA**************//
//* model Example {
//*   id       Int
//*   Int
//*   String
//*   Boolean
//*   DateTime
//*   Enum

//*   createdAt
//*   updatedAt

//*   example example?  @relation("ExampleHierarchy", fields: [exampleId], references: [id])
//*   example example?  @relation(fields: [exampleId], references: [id])
//*   example Example[] @relation("ExampleHierarchy")
//*   example example[]

//*   @@unique([exampleId, example])
//* }
//***************************************//

enum Role {
  Employee
  Manager
  Hr
}

enum LeaveStatus {
  Pending
  Approval
  Rejected
}



enum NotificationType {
  LeaveRequestSubmitted
  LeaveRequestApproved
  LeaveRequestRejected
  General
}

model User {
  id           Int      @id @default(autoincrement())
  companyId    Int
  failedLoginAttempts Int       @default(0)
  managerId    Int?
  departmentId Int?
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  twoFactorSecret  String?
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  hireDate     DateTime
  lockedUntil          DateTime?
  twoFactorEnabled Boolean @default(false)
  role         Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  manager           User?           @relation("ManagerHierarchy", fields: [managerId], references: [id])
  department        Department?     @relation(fields: [departmentId], references: [id])
  company           Company         @relation(fields: [companyId], references: [id])
  teamMembers       User[]          @relation("ManagerHierarchy")
  statusChanges     StatusHistory[] @relation("StatusChanges")
  submittedRequests LeaveRequest[]  @relation("SubmittedRequests")
  approvedRequests  LeaveRequest[]  @relation("ApprovedRequests")
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  leaveBalances     LeaveBalance[]
  comments          Comment[]
  workSchedule      WorkSchedule?

  @@index([companyId])
}

model RateLimitEntry {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model LeaveType {
  id                  Int     @id @default(autoincrement())
  companyId           Int
  name                String
  requiresApproval    Boolean
  countsTowardBalance Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company        @relation(fields: [companyId], references: [id])
  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

model Holiday {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  isRecurring Boolean
  date        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model LeaveRequest {
  id           Int         @id @default(autoincrement())
  totalDays    Int
  userId       Int
  leaveTypeId  Int
  companyId    Int
  approvedById Int?
  comment      String?
  status       LeaveStatus

  startDate DateTime
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User            @relation("SubmittedRequests", fields: [userId], references: [id])
  approvedBy    User?           @relation("ApprovedRequests", fields: [approvedById], references: [id])
  leaveType     LeaveType       @relation(fields: [leaveTypeId], references: [id])
  company       Company         @relation(fields: [companyId], references: [id])
  attachments   Attachment[]
  statusHistory StatusHistory[]
  comments      Comment[]
}

model LeaveBalance {
  id          Int @id @default(autoincrement())
  userId      Int
  leaveTypeId Int
  year        Int
  totalDays   Int
  usedDays    Int
  companyId   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([userId, leaveTypeId, year])
}

model Department {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  users   User[]
}

model WorkSchedule {
  id           Int @id @default(autoincrement())
  userId       Int @unique
  companyId    Int
  hoursPerWeek Int

  isPartTime Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Attachment {
  id             Int      @id @default(autoincrement())
  leaveRequestId Int
  fileName       String
  filePath       String
  uploadedAt     DateTime @default(now())

  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
}

model StatusHistory {
  id             Int         @id @default(autoincrement())
  leaveRequestId Int
  changedById    Int
  companyId      Int
  changedAt      DateTime    @default(now())
  oldStatus      LeaveStatus
  newStatus      LeaveStatus

  changedBy    User         @relation("StatusChanges", fields: [changedById], references: [id])
  company      Company      @relation(fields: [companyId], references: [id])
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  type      NotificationType

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  performedById Int
  entityId      Int
  companyId     Int
  action        String
  entityType    String
  oldValue      String?
  newValue      String?
  createdAt     DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id])
  performedBy User    @relation(fields: [performedById], references: [id])
}

model CompanySettings {
  id                     Int     @id @default(autoincrement())
  minDaysNoticeForLeave  Int     @default(1)
  defaultAnnualLeaveDays Int     @default(20)
  companyId              Int     @unique
  companyName            String
  workWeekStartsMonday   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  departments     Department[]
  leaveTypes      LeaveType[]
  holidays        Holiday[]
  leaveRequests   LeaveRequest[]
  leaveBalances   LeaveBalance[]
  workSchedules   WorkSchedule[]
  statusHistories StatusHistory[]
  auditLogs       AuditLog[]
  companySettings CompanySettings?
  comments        Comment[]
  apiKeys         ApiKey[]
}

model Comment {
  id             Int      @id @default(autoincrement())
  leaveRequestId Int
  authorId       Int
  companyId      Int
  text           String
  createdAt      DateTime @default(now())

  company      Company      @relation(fields: [companyId], references: [id])
  leaveRequest LeaveRequest @relation(fields: [leaveRequestId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
}

model ApiKey {
  id         Int       @id @default(autoincrement())
  companyId  Int
  key        String    @unique
  name       String
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])
}
